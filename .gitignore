# ── Local data (never commit raw sensor data) ─────────────────────────────────
# Dataset is published on Zenodo (DOI 10.5281/zenodo.4064802) — see README.
# We do NOT mirror it here.
data/
data_raw/

# ── Manuscript (private — paper text + figures + bundled prior-paper PDF) ────
# This repo is for the reproducible pipeline only; the paper itself stays
# local. The autonomous loop edits manuscript/ on disk during DRAFTING /
# REVIEWING phases but never stages or commits anything under this path.
manuscript/

# ── Internal project-management & authoring artefacts (kept on disk, never ───
#    published — these are working notes, not part of the reproducible release).
